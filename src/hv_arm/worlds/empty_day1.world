<sdf version='1.9'>
  <world name='empty_world'>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

  <!-- ================= RED BOTTLE ================= -->
  <model name="bottle">

    <!-- Pose of the bottle centre in the Gazebo world frame -->
    <pose>0.70 0.60 0.74 0 0 0</pose>

    <!-- The bottle must respond to gravity and forces -->
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="bottle_link">

      <!-- Physical mass and rotational inertia -->
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.25</mass>

        <inertia>
          <ixx>0.000724</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.000724</iyy>
          <iyz>0.0</iyz>
          <izz>0.000098</izz>
        </inertia>
      </inertial>

      <!-- Simplified physics and collision shape -->
      <collision name="bottle_collision">
        <geometry>
          <cylinder>
            <radius>0.028</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Main red body -->
      <visual name="bottle_body_visual">
        <pose>0 0 -0.02 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.028</radius>
            <length>0.14</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.8 0.0 0.0 1</ambient>
          <diffuse>1.0 0.0 0.0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- Narrow upper neck -->
      <visual name="bottle_neck_visual">
        <pose>0 0 0.0625 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.025</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.8 0.0 0.0 1</ambient>
          <diffuse>1.0 0.0 0.0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- Dark bottle cap -->
      <visual name="bottle_cap_visual">
        <pose>0 0 0.0825 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.013</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

    </link>
  </model>

	<model name='Trash_01_001'>
        <static>true</static>    
        <include>
            <uri>model://aws_robomaker_residential_Trash_01</uri>
        </include>
        <pose frame=''>0.6 -0.6 0.0 0 0 0</pose>
	</model>

